NODE_ENV=development
PORT=4000
ORIGIN=http://localhost:5173
# npm run dev provisions a real local MongoDB automatically when this is empty.
MONGODB_URI=
SESSION_SECRET=replace-with-at-least-32-random-characters
UPLOADS_MODE=local
MAIL_MODE=local
ALLOW_REGISTRATION=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
MAIL_FROM=
DEMO_ENABLED=true
DEMO_PASSWORD=
